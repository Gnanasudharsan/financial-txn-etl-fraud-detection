# Copy to .env and replace every value. Never commit .env.
FINTXN_ENV=local

# --- Object storage (S3 API: SeaweedFS locally, AWS S3 / Cloudflare R2 remotely) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
# Pipeline identity (data_engineer role)
S3_ACCESS_KEY=change-me-engineer-key
S3_SECRET_KEY=change-me-engineer-secret
# Bootstrap admin (bucket creation only)
S3_ADMIN_ACCESS_KEY=change-me-admin-key
S3_ADMIN_SECRET_KEY=change-me-admin-secret
# SSE-S3 key-encryption key for the local object store (hex, 32 bytes)
S3_SSE_KEK=
# Read-only identities used to demo RBAC
S3_ANALYST_ACCESS_KEY=change-me-analyst-key
S3_ANALYST_SECRET_KEY=change-me-analyst-secret
S3_AUDITOR_ACCESS_KEY=change-me-auditor-key
S3_AUDITOR_SECRET_KEY=change-me-auditor-secret

# --- PII protection (generate with: make keys) ---
# HMAC-SHA256 key for card-number tokenization (hex, 32 bytes)
FINTXN_TOKEN_KEY=
# AES-256-GCM key for column encryption (base64, 32 bytes)
FINTXN_ENCRYPTION_KEY=
# Role used by the PII decrypt utility: data_engineer | analyst | auditor
FINTXN_ROLE=data_engineer

# --- Spark ---
SPARK_DRIVER_MEMORY=6g

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
